{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "fix/dot-single-logbook-review": false,
      "fix/dot-wizard-wallet": false,
      "fix/dot-package-confirmation": false,
      "chore/lock-approved-dot-workflow": false,
      "docs/scanner-reader-strategy": false,
      "feat/scanner-clear-review": false,
      "fix/reader-form-labels": false,
      "fix/current-load-picker": false,
      "fix/shipment-completion-links": false,
      "fix/native-pdf-route-reading": false,
      "fix/native-rate-broker": false,
      "feat/outlook-document-import": false,
      "feat/smart-load-folders": false,
      "fix/hos-split-midnight": false,
      "fix/scanner-paper-capture": false,
      "fix/device-handoff-session": false,
      "fix/reviewed-folder-filing": false,
      "feat/compact-dark-workspace": false,
      "feat/driver-home-active-load-20261108": false,
      "fix/iphone-scanner-camera-freeze-20261108": false
    }
  },
  "installCommand": "npm ci --no-audit --no-fund --prefer-online --registry=https://registry.npmjs.org/",
  "buildCommand": "node scripts/build-v110.mjs",
  "outputDirectory": ".next",
  "headers": [
    {
      "source": "/app-version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate, proxy-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/update.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate, proxy-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, max-age=0, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
